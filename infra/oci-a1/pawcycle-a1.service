[Unit]
Description=PawCycle OCI A1 single provisioning tick
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=pawcycle-a1
Group=pawcycle-a1
StateDirectory=pawcycle-a1
StateDirectoryMode=0700
UMask=0077
EnvironmentFile=/etc/pawcycle-a1/worker.env
WorkingDirectory=/opt/pawcycle-a1
ExecStart=/opt/pawcycle-a1/venv/bin/python /opt/pawcycle-a1/scripts/oci_a1_provisioner.py --config /etc/pawcycle-a1/provisioner.json --state-dir /var/lib/pawcycle-a1
# Runs even after failure. Only this fixed local timer can be stopped as root.
ExecStopPost=+/bin/sh -c 'if test -f /var/lib/pawcycle-a1/STOP; then /usr/bin/systemctl stop --no-block pawcycle-a1.timer; fi'
TimeoutStartSec=50min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/pawcycle-a1
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
