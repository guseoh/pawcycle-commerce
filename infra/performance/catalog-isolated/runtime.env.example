# Copy this file to a root-owned 0600 runtime env file outside the repository.
# Do not put PAWCYCLE_PERF_DB_PASSWORD here. Store the password in a separate
# root-owned 0400/0600 file and pass it with --password-file.

PAWCYCLE_PERF_DATASET_ID=catalog-core-control-v1
PAWCYCLE_PERF_SCHEMA=pawcycle_perf_core_control
PAWCYCLE_PERF_BACKEND_IMAGE=ghcr.io/guseoh/pawcycle-backend@sha256:<approved-64-hex-digest>
PAWCYCLE_PERF_DB_URL=jdbc:mysql://<oci-mysql-endpoint>:3306/pawcycle_perf_core_control?sslMode=REQUIRED
PAWCYCLE_PERF_DB_USERNAME=pawcycle_perf_catalog
PAWCYCLE_PERF_HOST_PORT=18080
