# Fixed leaf-name contract under the user-supplied SSM prefix.
# Values shown here are placeholders only. Never copy a materialized runtime file into the repository.
MYSQL_DATABASE=<SSM SecureString value>
MYSQL_USER=<SSM SecureString value>
MYSQL_PASSWORD=<SSM SecureString value>
MYSQL_ROOT_PASSWORD=<SSM SecureString value>
# NOT-SSM: these non-secret runtime inputs are supplied only as explicit
# materializer flags; do not create these as Parameter Store leaf parameters.
# Docker default: mysql / 3306 / DISABLED. Future RDS: <endpoint>.ap-northeast-2.rds.amazonaws.com / 3306 / REQUIRED.
PAWCYCLE_DATASOURCE_HOST=<explicit runtime flag; do not store as a secret>
PAWCYCLE_DATASOURCE_PORT=3306
PAWCYCLE_DATASOURCE_SSL_MODE=DISABLED
