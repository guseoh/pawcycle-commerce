# Copy this file to .env.local and replace every placeholder locally.
# .env.local is excluded by the repository root .gitignore.
MYSQL_DATABASE=<local-database-name>
MYSQL_USER=<local-database-user>
MYSQL_PASSWORD=<local-database-password>
MYSQL_ROOT_PASSWORD=<local-root-password>
PAWCYCLE_LOCAL_ALERTMANAGER_PORT=9094
# Ignored local runtime file containing only the Discord webhook URL.
PAWCYCLE_LOCAL_DISCORD_WEBHOOK_FILE=<absolute-local-webhook-file>
PAWCYCLE_LOCAL_GRAFANA_PORT=3001
PAWCYCLE_LOCAL_HTTP_PORT=8080
PAWCYCLE_LOCAL_PROMETHEUS_PORT=9090
PAWCYCLE_LOCAL_QA_BOOTSTRAP_EMAIL=<qa-foundation-004-email>
PAWCYCLE_LOCAL_QA_BOOTSTRAP_PASSWORD=<qa-foundation-004-password>
PAWCYCLE_LOCAL_QA_BOOTSTRAP_RESET_SUBSCRIPTIONS=false
# Toss Test only (docs/runbook/PAYMENT-TOSS-TEST-001). Use test_ck_/test_sk_ keys from your own
# Toss developer account. Never put live_ keys here. Leave unset unless running that runbook.
# PAWCYCLE_TOSS_TEST_CLIENT_KEY=<test_ck_...>
# PAWCYCLE_TOSS_TEST_SECRET_KEY=<test_sk_...>
