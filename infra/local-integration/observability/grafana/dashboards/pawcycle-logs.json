{
  "uid": "pawcycle-logs",
  "title": "PawCycle Logs",
  "tags": [
    "pawcycle",
    "local",
    "logs"
  ],
  "editable": false,
  "schemaVersion": 41,
  "version": 1,
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "refresh": "30s",
  "description": "OBS-STACK-001 local logs. Filter by service, level and free text (request id, jobRunId, paymentId, event name).",
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "service",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "pawcycle-loki"
        },
        "query": {
          "type": 1,
          "label": "service",
          "stream": "",
          "refId": "service"
        },
        "definition": "label_values(service)",
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "level",
        "label": "level (backend)",
        "type": "custom",
        "query": "ERROR,WARN,INFO,DEBUG",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "search",
        "label": "text (request id, jobRunId, paymentId, event)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "ERROR lines per minute",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "pawcycle-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "pawcycle-loki"
          },
          "expr": "sum by (service) (count_over_time({service=~\"$service\", level=\"ERROR\"}[1m]))",
          "legendFormat": "{{service}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Business events per minute",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "pawcycle-loki"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "pawcycle-loki"
          },
          "expr": "sum by (event) (count_over_time({service=\"backend\"} |= \"pawcycle.business-event\" | regexp \"event=(?P<event>[a-z.]+)\" [1m]))",
          "legendFormat": "{{event}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "logs",
      "title": "Logs",
      "gridPos": {
        "h": 20,
        "w": 24,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "loki",
        "uid": "pawcycle-loki"
      },
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "pawcycle-loki"
          },
          "expr": "{service=~\"$service\", level=~\"$level\"} |~ \"(?i)$search\""
        }
      ]
    }
  ]
}
